[Unit]
Description=Weekly trigger for the Goldfinger BOM formula refresh
Documentation=file:/opt/goldfinger/Backend/docs/bom-persistence-phase1.md

[Timer]
# The prod box runs in UTC. 10:00 UTC Sat ~= 06:00 US-Eastern (EDT) / 05:00 (EST) —
# genuinely Saturday morning for US users, and a very low-traffic window either way.
# Adjust this one line to move the schedule.
OnCalendar=Sat 10:00
# If the box was off/asleep at the scheduled time, run once on next boot instead of skipping.
Persistent=true
# Small jitter so we never hammer NetSuite at a hard-edged instant.
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
